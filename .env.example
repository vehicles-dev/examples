# Server-side secret. Never expose this in browser or mobile code.
VEHICLES_API_KEY=

# Private vehicle identifier. Do not log or commit it.
VEHICLES_VIN=

# Generate once per logical history-report order, then persist and reuse it for retries.
VEHICLES_IDEMPOTENCY_KEY=

# Keep this at no except for the one command that intentionally places a billable order.
VEHICLES_CONFIRM_BILLABLE_REPORT=no
